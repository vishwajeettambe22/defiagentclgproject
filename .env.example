# ============================================================
# AI-Driven Conversational DeFi Transaction Agent
# Environment Configuration Template
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# --- AI/NLP ---
GOOGLE_API_KEY=your_google_api_key_here
AI_MODEL=gemini-2.5-flash

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://defi_user:defi_pass@localhost:5432/defi_agent_db

# --- Blockchain / Testnet ---
# Use Sepolia testnet RPC (Alchemy or Infura)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key_here
CHAIN_ID=11155111
NETWORK_NAME=Sepolia

# --- Smart Contract Addresses (filled after deployment) ---
DEFI_AGENT_CONTRACT=0x0000000000000000000000000000000000000000
INTEGRITY_ANCHOR_CONTRACT=0x0000000000000000000000000000000000000000

# --- Security / Validation ---
# Maximum ETH amount per transaction (spending limit)
MAX_TX_AMOUNT_ETH=1.0
# Allowed operations (comma-separated)
ALLOWED_OPERATIONS=transfer,swap,stake
# Allowed tokens (comma-separated, uppercase symbols)
ALLOWED_TOKENS=ETH,USDC,DAI,WETH

# --- App ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (set in frontend/.env) ---
# VITE_BACKEND_URL=http://localhost:8000
# VITE_CHAIN_ID=11155111
